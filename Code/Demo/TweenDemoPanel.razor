@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Construct;
@using SboxTween;
@inherits PanelComponent
@namespace SboxTweenExample

<root>
	<div class="panel" @ref="MainPanel">
		<div class="title">SboxTween</div>
		<div class="subtitle">PrimeTween for s&box</div>

		<div class="section">Stands</div>
		<div class="row nav">
			<div class="button nav-button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.FocusPrevious() ) )>‹</div>
			<div class="nav-title">@( Demo?.FocusedStand?.Title ?? "Overview" )</div>
			<div class="button nav-button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.FocusNext() ) )>›</div>
		</div>
		<div class="dots">
			<div class="dot overview @( Focus == -1 ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.FocusStand( -1 ) ) )></div>
			@for ( int i = 0; i < TweenDemo.Stands.Length; i++ )
			{
				int index = i;
				<div class="dot @( Focus == index ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.FocusStand( index ) ) )></div>
			}
		</div>
		@* The description is typed from code with the Label typewriter, razor doesn't touch its text *@
		<label class="description" @ref="Description"></label>

		<div class="section">Actions</div>
		@if ( Focus == 0 )
		{
			<div class="row">
				<div class="button @( Demo?.IsRaceSlow == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ToggleRaceClock() ) )>Race ×0.25</div>
			</div>
		}
		else if ( Focus == 1 )
		{
			<div class="row">
				<div class="button progress-button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.PlaySequence() ) )>
					<div class="progress-fill" style="width: @( (Demo?.SequenceProgress ?? 0) * 100 )%"></div>
					<div class="button-text">Play Sequence</div>
				</div>
			</div>
		}
		else if ( Focus == 2 )
		{
			<div class="row">
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.Punch() ) )>Punch</div>
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ShakeObject() ) )>Shake</div>
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ShakeCamera() ) )>Camera</div>
			</div>
		}
		else if ( Focus == 6 )
		{
			<div class="row">
				<div class="button @( Demo?.IsGateWaiting == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.OpenGate() ) )>Open Gate</div>
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.AdditiveSpin() ) )>Spin +90°</div>
			</div>
		}
		else if ( Focus == 7 )
		{
			<div class="row">
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.Dissolve() ) )>Dissolve</div>
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ShiftGlowColor() ) )>Glow Color</div>
			</div>
		}
		else if ( Focus == 8 )
		{
			<div class="row">
				<div class="button @( Demo?.IsCrouching == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ToggleCrouch() ) )>Crouch</div>
				<div class="button @( Demo?.IsWalking == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ToggleWalk() ) )>Walk</div>
			</div>
			<div class="row">
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.Smile() ) )>Smile</div>
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.Talk() ) )>Talk</div>
			</div>
		}
		else if ( Focus == 9 )
		{
			<div class="row">
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.HitEffect() ) )>Hit</div>
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.DreamEffect() ) )>Dream</div>
				<div class="button @( Demo?.IsNoir == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ToggleNoir() ) )>Noir</div>
			</div>
		}
		else if ( Focus == 10 )
		{
			<div class="row">
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.SkipQuote() ) )>Skip</div>
				<div class="button @( Demo?.IsFastTyping == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ToggleTypingSpeed() ) )>Fast Typing</div>
			</div>
		}
		else if ( Focus == 11 )
		{
			<div class="row">
				<div class="button @( Demo?.IsNight == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ToggleDayNight() ) )>Night</div>
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.FlickerLamp() ) )>Flicker</div>
				<div class="button @( Demo?.IsFanFast == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ToggleFanSpeed() ) )>Fan</div>
			</div>
		}
		else if ( Focus == 12 )
		{
			<div class="row">
				<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ResetCrates() ) )>Reset Crates</div>
			</div>
		}
		else if ( Focus == -1 )
		{
			<div class="hint">Pick a stand with the arrows or the dots, the camera flies there.</div>
		}
		else
		{
			<div class="hint">This stand only plays idle animations.</div>
		}

		<div class="section">UI</div>
		<div class="row">
			<div class="button" onclick=@( ( PanelEvent e ) => Press( e, OpenShowcase ) )>UI Showcase</div>
			<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => ShowToast( "Hello from a toast!" ) ) )>Toast</div>
		</div>

		<div class="section">Control</div>
		<div class="row">
			<div class="button @( Demo?.IsSlowMotion == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.ToggleSlowMotion() ) )>Slow-mo</div>
			<div class="button @( Demo?.IsPaused == true ? "active" : "" )" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.TogglePause() ) )>Pause All</div>
		</div>
		<div class="row">
			<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.CompleteAll() ) )>Complete All</div>
			<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.StopAll() ) )>Stop All</div>
			<div class="button" onclick=@( ( PanelEvent e ) => Press( e, () => Demo?.Rebuild() ) )>Rebuild</div>
		</div>

		<div class="stats">
			<div class="stat"><span class="label">Alive tweens</span><span class="value">@( Demo?.Manager?.TweensCount ?? 0 )</span></div>
			<div class="stat"><span class="label">Max alive</span><span class="value">@( Demo?.Manager?.MaxAliveTweens ?? 0 )</span></div>
			<div class="stat"><span class="label">Async loops</span><span class="value">@( Demo?.AsyncLoops ?? 0 )</span></div>
			<div class="stat"><span class="label">Callbacks</span><span class="value">@( Demo?.Callbacks ?? 0 )</span></div>
			<div class="stat"><span class="label">Time scale</span><span class="value">@Scene.TimeScale.ToString( "0.00" )</span></div>
		</div>
	</div>

	@* Toasts are added from code, razor leaves this container's children alone *@
	<div class="toasts" @ref="Toasts"></div>

	@if ( IsShowcaseOpen )
	{
		<div class="showcase" @ref="Showcase">
			<div class="showcase-window">
				<div class="showcase-header">
					<div class="showcase-title">UI Showcase</div>
					<div class="button close" onclick=@( ( PanelEvent e ) => Press( e, CloseShowcase ) )>Close</div>
				</div>
				<div class="cards" @ref="CardList">
					<div class="card" onclick=@( ( PanelEvent e ) => CardTransform( e.This ) )>
						<div class="card-title">Transform</div>
						<div class="card-hint">punch scale + rotate, released back to CSS</div>
					</div>
					<div class="card" onclick=@( ( PanelEvent e ) => CardColor( e.This ) )>
						<div class="card-title">Color</div>
						<div class="card-hint">background and border color</div>
					</div>
					<div class="card" onclick=@( ( PanelEvent e ) => CardBlur( e.This ) )>
						<div class="card-title">Filter</div>
						<div class="card-hint">blur and saturate sequence</div>
					</div>
					<div class="card" onclick=@( ( PanelEvent e ) => CardLayout( e.This ) )>
						<div class="card-title">Layout</div>
						<div class="card-hint">width, neighbours reflow</div>
					</div>
					<div class="card" onclick=@( ( PanelEvent e ) => CardShake( e.This ) )>
						<div class="card-title">Shake</div>
						<div class="card-hint">shake translate + rotate</div>
					</div>
					<div class="card" onclick=@( ( PanelEvent e ) => CardCounter( e.This ) )>
						<div class="card-title">Counter</div>
						<div class="card-value">@CounterValue.ToString( "0" )</div>
					</div>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	[Property] public TweenDemo Demo { get; set; }

	Panel MainPanel { get; set; }
	Label Description { get; set; }
	Panel Toasts { get; set; }
	Panel Showcase { get; set; }
	Panel CardList { get; set; }

	bool IsShowcaseOpen { get; set; }
	bool _showcaseIntroPending;
	bool _isShowcaseClosing;
	string _lastEvent;
	int _typedFocus = int.MinValue;

	int Focus => Demo?.FocusIndex ?? -1;
	float CounterValue { get; set; }
	readonly HashSet<Panel> _expandedCards = [];

	protected override void OnStart()
	{
		Demo ??= Scene.Get<TweenDemo>();
	}

	protected override void OnTreeFirstBuilt()
	{
		base.OnTreeFirstBuilt();
		MainPanel.TweenSlideIn( new Vector2( -60, 0 ), 0.6f );
	}

	protected override void OnTreeBuilt()
	{
		base.OnTreeBuilt();
		if ( _showcaseIntroPending && CardList.IsValid() )
		{
			_showcaseIntroPending = false;
			PlayShowcaseIntro();
		}
	}

	protected override void OnUpdate()
	{
		// Every demo event pops a toast
		var lastEvent = Demo?.LastEvent;
		if ( lastEvent != _lastEvent )
		{
			_lastEvent = lastEvent;
			ShowToast( lastEvent );
		}

		// The description of the focused stand is typed in
		if ( Focus != _typedFocus && Description.IsValid() )
		{
			_typedFocus = Focus;
			Description.TweenTypewriterAtSpeed( Demo?.FocusedStand?.Description ?? "All stands. Every animation here is a tween or a sequence of tweens.", 90 );
		}
	}

	/// <summary>Every button squashes on click; the scale goes back to CSS when the punch ends.</summary>
	void Press( PanelEvent e, Action action )
	{
		e.This.PunchScale( new Vector2( 0.12f, -0.08f ), 0.35f, 8 ).ReleaseStyleOnComplete();
		action?.Invoke();
	}

	void ShowToast( string text )
	{
		if ( !Toasts.IsValid() || string.IsNullOrEmpty( text ) )
			return;

		// Keep only the newest toasts
		while ( Toasts.ChildrenCount >= 4 )
			Toasts.Children.First().Delete( true );

		var toast = Toasts.Add.Panel( "toast" );
		toast.Add.Label( text );

		var sequence = toast.TweenSlideIn( new Vector2( 60, 0 ), 0.35f )
			.ChainDelay( 1.6f )
			.Chain( toast.TweenSlideOut( new Vector2( 60, 0 ), 0.25f ) );
		toast.DeleteAfter( sequence );
	}

	#region Showcase

	void OpenShowcase()
	{
		if ( IsShowcaseOpen )
			return;

		IsShowcaseOpen = true;
		_isShowcaseClosing = false;
		_showcaseIntroPending = true;
		_expandedCards.Clear();
	}

	/// <summary>Cards pop in one after another: each card's sequence is inserted with a growing delay.</summary>
	void PlayShowcaseIntro()
	{
		var sequence = Sequence.Create( Showcase.TweenFadeIn( 0.25f ) )
			.Group( Showcase.TweenBackdropBlur( 0, 6, 0.4f ) );

		int index = 0;
		foreach ( var card in CardList.Children )
			sequence.Insert( 0.1f + index++ * 0.06f, card.TweenPopIn( 0.35f ) );
	}

	void CloseShowcase()
	{
		if ( !IsShowcaseOpen || _isShowcaseClosing || !Showcase.IsValid() )
			return;

		_isShowcaseClosing = true;
		var sequence = Sequence.Create();
		int index = 0;
		foreach ( var card in CardList.Children.Reverse() )
			sequence.Insert( index++ * 0.04f, card.TweenPopOut( 0.2f ) );

		sequence.Chain( Showcase.TweenFadeOut( 0.15f ) )
			.OnComplete( this, static panel => panel.IsShowcaseOpen = false );
	}

	void CardTransform( Panel card )
	{
		card.PunchScale( new Vector2( 0.2f, 0.2f ), 0.5f ).ReleaseStyleOnComplete();
		card.PunchRotate( 10, 0.5f ).ReleaseStyleOnComplete();
	}

	void CardColor( Panel card )
	{
		var color = new ColorHsv( Random.Shared.Float( 0, 360 ), 0.6f, 0.8f ).ToColor();
		card.TweenBackgroundColor( color.WithAlpha( 0.5f ), 0.4f );
		card.TweenBorderColor( color, 0.4f );
	}

	void CardBlur( Panel card )
	{
		Sequence.Create( card.TweenFilterBlur( 0, 6, 0.25f ) )
			.Group( card.TweenFilterSaturate( 1, 0, 0.25f ) )
			.Chain( card.TweenFilterBlur( 6, 0, 0.35f ) )
			.Group( card.TweenFilterSaturate( 0, 1, 0.35f ) )
			.ReleaseStyleOnComplete();
	}

	void CardLayout( Panel card )
	{
		// Layout properties reflow the neighbours every frame; prefer transforms when the layout doesn't need to change
		bool expand = _expandedCards.Add( card );
		if ( !expand )
			_expandedCards.Remove( card );

		card.TweenWidth( Length.Pixels( expand ? 320 : 180 ), 0.45f, Ease.OutBack );
	}

	void CardShake( Panel card )
	{
		card.ShakeTranslate( new Vector2( 12, 6 ), 0.5f );
		card.ShakeRotate( 6, 0.5f );
	}

	/// <summary>Animating a field works too: razor renders the value, BuildHash makes it rebuild.</summary>
	void CardCounter( Panel card )
	{
		card.PunchScale( new Vector2( 0.1f, 0.1f ), 0.3f ).ReleaseStyleOnComplete();
		float target = CounterValue < 500 ? 1000 : 0;
		Tween.Custom( this, CounterValue, target, 1.2f, static ( panel, value ) => panel.CounterValue = value, Ease.OutCubic );
	}

	#endregion

	protected override int BuildHash() => HashCode.Combine(
		Demo?.Manager?.TweensCount,
		Demo?.SequenceProgress,
		Demo?.AsyncLoops,
		Demo?.Callbacks,
		Scene.TimeScale,
		HashCode.Combine( Demo?.IsSlowMotion, Demo?.IsPaused, Demo?.IsGateWaiting, Demo?.IsRaceSlow ),
		HashCode.Combine( Focus, Demo?.IsCrouching, Demo?.IsWalking, Demo?.IsNoir, Demo?.IsNight, Demo?.IsFastTyping, Demo?.IsFanFast ),
		HashCode.Combine( IsShowcaseOpen, CounterValue ) );
}
